{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": false
  },
  "angularCompilerOptions": {
    "strictTemplates": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
